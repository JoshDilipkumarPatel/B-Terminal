# =========================================================================
#                    B-TERMINAL ENVIRONMENT VARIABLES TEMPLATE
# =========================================================================
# Copy this file to `.env` and fill in your private API credentials.
# This file serves as a reference for environment override configuration.
# =========================================================================

# Indian Equities Brokerage (Groww API)
GROWW_API_KEY="YOUR_GROWW_API_TOKEN_HERE"
GROWW_API_SECRET="YOUR_GROWW_SECRET_HERE"

# Crypto Exchange & INR Trading (CoinDCX)
COINDCX_API_KEY="YOUR_COINDCX_API_KEY_HERE"
COINDCX_API_SECRET="YOUR_COINDCX_SECRET_HERE"

# US Equities & Global Markets (Alpaca / Binance - Optional)
ALPACA_API_KEY="YOUR_ALPACA_KEY_HERE"
ALPACA_API_SECRET="YOUR_ALPACA_SECRET_HERE"
BINANCE_API_KEY="YOUR_BINANCE_KEY_HERE"
BINANCE_API_SECRET="YOUR_BINANCE_SECRET_HERE"

# Application Settings
LOG_LEVEL="info"               # trace, debug, info, warn, error
KI_AI_MIN_CONFIDENCE="0.75"    # Minimum statistical confidence score to execute autonomous orders
KELLY_CRITERION_MODE="half"    # full, half, quarter (Risk scaling parameter)
